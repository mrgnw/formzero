{
  "extends": "./tsconfig.react.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "components/**/*",
    "app/lib/**/*",
    "app/hooks/**/*",
    "app/types/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "src/lib/server/email.ts",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "#/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
