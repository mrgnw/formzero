{
	"name": "formzero",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rm -rf .wrangler/deploy && vite build",
		"migrate": "yes Y | wrangler d1 migrations apply DB",
		"seed": "yes Y | wrangler d1 execute DB --file seed.sql",
		"cf-typegen": "wrangler types --include-main-module=false",
		"deploy": "npm run build && npm run migrate -- --remote && wrangler deploy",
		"dev": "npm run build && wrangler dev --port 5473",
		"postinstall": "npm run cf-typegen",
		"test:e2e": "playwright test",
		"typecheck": "npm run cf-typegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"better-auth-generate": "@better-auth/cli@latest generate --output migrations/change-this-name.sql --config better-auth/config.ts --y",
		"env": "dotenv -e .dev.vars --",
		"env:prod": "dotenv -e .dev.vars.production --",
		"prepare": "svelte-kit sync || echo ''"
	},
	"dependencies": {
		"better-auth": "^1.7.25",
		"better-sqlite3": "^12.6.2",
		"dotenv-cli": "^10.0.0",
		"kysely-d1": "^0.4.0",
		"nodemailer": "^7.0.13",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.73.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.19.7",
		"@types/nodemailer": "^7.0.9",
		"@types/prismjs": "^1.26.6",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"prismjs": "^1.30.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	},
	"cloudflare": {
		"bindings": {
			"BETTER_AUTH_SECRET": {
				"description": "Secret for authentication system. Use https://jwtsecrets.com or `openssl rand -hex 16` to generate a secure secret (32 characters). No need to remember it"
			}
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
