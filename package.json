{
	"name": "formzero",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build --config vite.react.config.ts && vite build && cp -R build/react/client/. .svelte-kit/cloudflare/",
		"migrate": "yes Y | wrangler d1 migrations apply DB",
		"seed": "yes Y | wrangler d1 execute DB --file seed.sql",
		"cf-typegen": "wrangler types --include-main-module=false",
		"deploy": "npm run build && npm run migrate -- --remote && wrangler deploy",
		"dev": "npm run build && wrangler dev --port 5473",
		"postinstall": "npm run cf-typegen",
		"test:e2e": "playwright test",
		"typecheck": "npm run cf-typegen && svelte-kit sync && react-router typegen --config vite.react.config.ts && tsc -b tsconfig.react.json && tsc -p tsconfig.json",
		"better-auth-generate": "@better-auth/cli@latest generate --output migrations/change-this-name.sql --config better-auth/config.ts --y",
		"env": "dotenv -e .dev.vars --",
		"env:prod": "dotenv -e .dev.vars.production --",
		"prepare": "svelte-kit sync || echo ''"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tanstack/react-table": "^8.21.3",
		"better-auth": "^1.7.25",
		"better-sqlite3": "^12.6.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"dotenv-cli": "^10.0.0",
		"isbot": "^5.1.34",
		"kysely-d1": "^0.4.0",
		"lucide-react": "^0.563.0",
		"next-themes": "^0.4.6",
		"nodemailer": "^7.0.13",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "^7.18.5",
		"recharts": "^2.15.4",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@react-router/dev": "^7.18.5",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.19.7",
		"@types/nodemailer": "^7.0.9",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"svelte": "^5.57.3",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vite-tsconfig-paths": "^6.1.1",
		"wrangler": "^4.162.0"
	},
	"cloudflare": {
		"bindings": {
			"BETTER_AUTH_SECRET": {
				"description": "Secret for authentication system. Use https://jwtsecrets.com or `openssl rand -hex 16` to generate a secure secret (32 characters). No need to remember it"
			}
		}
	}
}
