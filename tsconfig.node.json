{
  "extends": "./tsconfig.react.json",
  "include": ["vite.config.ts", "vite.react.config.ts", "react-router.config.ts", "better-auth.config.ts", "playwright.config.ts", "tests/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
